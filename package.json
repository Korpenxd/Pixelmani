{
  "name": "pixelmani",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/fix-export-segments.mjs",
    "lint": "eslint",
    "test": "node --import ./tests/register.mjs --test tests/*.test.ts",
    "serve:static": "node php/dev/serve-static.mjs",
    "package:loopia": "node scripts/package-deploy.mjs --target=loopia",
    "package:websupport": "node scripts/package-deploy.mjs --target=websupport-staging",
    "serve:package": "node php/dev/serve-static.mjs start --package",
    "test:package": "node php/dev/test-package-http.mjs",
    "serve:websupport": "node php/dev/serve-static.mjs start --websupport",
