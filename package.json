    "test:gate-tool": "node php/dev/test-gate-tool.mjs",
    "snapshot:staging": "node scripts/run-php.mjs scripts/staging-data-snapshot.php",
    "test:snapshot": "node scripts/test-staging-snapshot.mjs",
    "test:package-guards": "node scripts/test-package-guards.mjs"
