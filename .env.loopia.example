# Example configuration for the PHP/MySQL (Loopia) version of PixelMani.
#
# Copy to .env.loopia.local and fill in real values. .env.loopia.local is
# gitignored and must never be committed. Next.js does not read this file.
#
# Used by: the PHP backend in php/ (local development only; staging and
# production use real environment variables or php/config/config.php) and
# db/tools/import-bundle.php (local database only).

APP_ENV=local
SITE_URL=http://pixelmani.test

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pixelmani_local
DB_USER=pixelmani
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4

# Optional: URL path (same origin) where photo files are served. Default /media.
# UPLOAD_URL_BASE=/media

# Admin login: output of PHP password_hash(), never the plaintext password.
#   php -r 'echo password_hash("your password", PASSWORD_DEFAULT), PHP_EOL;'
# Wrap it in single quotes (the hash contains "$").
ADMIN_PASSWORD_HASH='$2y$10$replace-with-your-own-hash'

# Optional admin session / login settings (defaults shown).
# SESSION_NAME=pixelmani_admin
# SESSION_IDLE_SECONDS=1800
# COOKIE_SECURE=false            # the default is false only with APP_ENV=local
# LOGIN_RATE_LIMIT_MAX=5
# LOGIN_RATE_LIMIT_WINDOW=900
# STORAGE_DIR=                   # default php/storage (sessions, rate-limit)

# Optional photo-upload settings (defaults shown).
# MEDIA_DIR=                     # default php/public/media (served at UPLOAD_URL_BASE)
# MAX_UPLOAD_BYTES=15728640      # per full-size image; thumbnails are capped at 2 MiB
# MAX_FILES_PER_REQUEST=20       # photos per request (PHP max_file_uploads counts 2 files per photo)
# MEDIA_QUOTA_MB=500             # managed media: MEDIA_DIR/uploads + MEDIA_DIR/hero
#                                # (also the hero image's byte limit is MAX_UPLOAD_BYTES)
