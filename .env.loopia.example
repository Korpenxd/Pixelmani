# Example configuration for the PHP/MySQL (Loopia) version of PixelMani.
#
# Copy to .env.loopia.local and fill in real values. .env.loopia.local is
# gitignored and must never be committed. Next.js does not read this file.
#
# Used today by: db/tools/import-bundle.php (local database only).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pixelmani_local
DB_USER=pixelmani
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4
